{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure Debug", "type": "process",
      "command": "cmake", "args": ["--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": []
    },
    {
      "label": "AudioDock: build Debug", "type": "process",
      "command": "cmake", "args": ["--build", "--preset", "debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "CMake: configure Debug", "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "CMake: configure Release", "type": "process",
      "command": "cmake", "args": ["--preset", "release"],
      "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": []
    },
    {
      "label": "AudioDock: build Release", "type": "process",
      "command": "cmake", "args": ["--build", "--preset", "release"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "CMake: configure Release", "problemMatcher": "$msCompile"
    },
    {
      "label": "AudioDock: publish Release", "type": "process",
      "command": "cmake", "args": ["--build", "--preset", "publish"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "CMake: configure Release", "problemMatcher": "$msCompile"
    }
  ]
}
