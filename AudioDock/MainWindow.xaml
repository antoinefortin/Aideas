<Window x:Class="AudioDock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AudioDock • YouTube → MP3" Width="1120" Height="880" MinWidth="900" MinHeight="720" Background="#0C1322" FontFamily="Segoe UI" FontSize="14" Closing="OnClosing">
 <Grid Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="◉  AudioDock" FontSize="32" FontWeight="Bold"/><TextBlock Text="Votre bibliothèque audio, à votre rythme." Foreground="#94A5BF" Margin="0,5,0,0"/></StackPanel><Button x:Name="InstallButton" Content="Installer / mettre à jour les outils" HorizontalAlignment="Right" VerticalAlignment="Center" Click="InstallClick"/></Grid>
  <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="14" Padding="22" Margin="0,0,0,16">
   <StackPanel><TextBlock Text="01  AJOUTER DES LIENS" FontSize="12" FontWeight="Bold" Foreground="#55DBC0" Margin="0,0,0,12"/>
    <TextBox x:Name="Urls" Height="95" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="Une URL YouTube par ligne : vidéo, playlist ou chaîne"/>
    <Grid Margin="0,12,0,0"><TextBlock Text="Vidéos • Playlists • Chaînes — un lien par ligne" Foreground="#94A5BF" VerticalAlignment="Center"/><Button Content="+ Ajouter à la file" HorizontalAlignment="Right" Background="#237E70" Click="AddClick"/></Grid>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="22" Margin="0,0,0,16">
   <StackPanel><TextBlock Text="02  CONFIGURER L’EXPORT" FontSize="12" FontWeight="Bold" Foreground="#55DBC0" Margin="0,0,0,12"/>
    <DockPanel><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseClick" Margin="10,0,0,0"/><TextBox x:Name="OutputPath" ToolTip="Saisissez ou collez un chemin complet, par exemple D:\Musique\Mes MP3" LostFocus="DestinationLostFocus"/></DockPanel>
    <CheckBox x:Name="DirectOutput" Content="Enregistrer directement dans ce dossier (sans sous-dossiers)" Foreground="White" IsChecked="True" Margin="0,12,0,0"/>
    <WrapPanel Margin="0,14,0,0"><TextBlock Text="Qualité MP3" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="Quality" Width="135" SelectedIndex="0" Padding="8"><ComboBoxItem Content="320 kb/s" Tag="320K"/><ComboBoxItem Content="256 kb/s" Tag="256K"/><ComboBoxItem Content="192 kb/s" Tag="192K"/><ComboBoxItem Content="128 kb/s" Tag="128K"/></ComboBox><CheckBox x:Name="Artwork" Content="Pochette intégrée" Foreground="White" IsChecked="True" VerticalAlignment="Center" Margin="20,0,0,0"/><CheckBox x:Name="Archive" Content="Ignorer les éléments déjà exportés" Foreground="White" IsChecked="True" VerticalAlignment="Center" Margin="20,0,0,0"/></WrapPanel>
   </StackPanel>
  </Border>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="StartButton" Content="▶  Démarrer" Background="#237E70" Click="StartClick"/><Button x:Name="StopButton" Content="Arrêter" IsEnabled="False" Click="StopClick"/><Button x:Name="RemoveButton" Content="Retirer la sélection" Click="RemoveClick"/><Button Content="Ouvrir le dossier" Click="OpenClick" Margin="0"/></StackPanel><TextBlock Text="03  FILE D’ATTENTE" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/></DockPanel>
   <ListView x:Name="QueueList" Grid.Row="1" Background="#131D2E" Foreground="#E6EDF8" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.Resources><Style TargetType="ListViewItem"><Setter Property="Padding" Value="8,10"/><Setter Property="Foreground" Value="#E6EDF8"/></Style><Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#25334A"/><Setter Property="Foreground" Value="#ADBDD3"/><Setter Property="Padding" Value="10"/></Style></ListView.Resources><ListView.View><GridView><GridViewColumn Header="Source" Width="400" DisplayMemberBinding="{Binding Url}"/><GridViewColumn Header="État" Width="250" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Fichier en cours" Width="320" DisplayMemberBinding="{Binding Current}"/></GridView></ListView.View></ListView>
   <TextBox x:Name="LogBox" Grid.Row="2" Margin="0,12,0,0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
  </Grid>
  <TextBlock x:Name="Footer" Grid.Row="4" Text="Prêt • MP3 avec métadonnées • Téléchargez uniquement les contenus que vous êtes autorisé à conserver." Foreground="#94A5BF" FontSize="11" Margin="0,16,0,0"/>
 </Grid>
</Window>
