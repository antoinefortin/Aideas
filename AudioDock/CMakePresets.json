{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug", "displayName": "AudioDock Debug",
      "generator": "Ninja", "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release", "displayName": "AudioDock Release",
      "generator": "Ninja", "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "targets": ["AudioDock"] },
    { "name": "release", "configurePreset": "release", "targets": ["AudioDock"] },
    { "name": "publish", "configurePreset": "release", "targets": ["publish"] }
  ]
}
